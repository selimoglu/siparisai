# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ana alan adı (restoranlar alt adres alır: kervanpide.siparisai.com)
NEXT_PUBLIC_ROOT_DOMAIN=siparisai.com

# Yapay zeka (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# İsteğe bağlı: model değiştirmek için
# AI_MODEL=claude-opus-5-5

# SMS (Netgsm). Boş bırakılırsa kampanyalar "deneme modu"nda çalışır, SMS gitmez.
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
# NETGSM_IYS_FILTER=11
